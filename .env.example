# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# REVENUECAT_API_KEY: Secret v1 REST API key from RevenueCat dashboard (e.g. sk_...) for server-side subscriber and entitlement verification.
REVENUECAT_API_KEY=

# VITE_REVENUECAT_PUBLIC_KEY: Public Web SDK key (e.g. rc_...) for RevenueCat Web Billing and Paywalls in the browser.
VITE_REVENUECAT_PUBLIC_KEY=

# REVENUECAT_WEBHOOK_SECRET: Optional webhook authorization header to verify RevenueCat webhooks.
REVENUECAT_WEBHOOK_SECRET=

# SPOTIFY_CLIENT_ID & SPOTIFY_CLIENT_SECRET: Spotify Developer Dashboard credentials for direct artist channel deploy
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# APPLE_MUSIC_TEAM_ID, KEY_ID, PRIVATE_KEY: Apple Developer MusicKit credentials for Apple Music direct catalog ingestion
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=

# TIDAL_CLIENT_ID & TIDAL_CLIENT_SECRET: Tidal Developer Dashboard credentials for Tidal Hi-Res/MQA direct ingestion
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# YOUTUBE_CLIENT_ID & YOUTUBE_CLIENT_SECRET: Google Cloud Console OAuth 2.0 Client credentials for direct YouTube Channel uploads
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
